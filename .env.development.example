# Template for the Development environment. Copy to ".env.development"
# (gitignored) if you want an explicit per-environment file instead of the
# generic ".env" — both are supported (see app.module.ts envFilePath order).
#
# Development currently runs in fully simulated mode: no PostgreSQL, no
# external engine required. Switch PERSISTENCE_DRIVER/ENGINE_DRIVER below
# once the Hetzner Development database and the real engine are reachable.
NODE_ENV=development

PERSISTENCE_DRIVER=memory
ENGINE_DRIVER=mock
MAIL_ENGINE_MODE=simulation
STORAGE_DRIVER=local

# Only needed once PERSISTENCE_DRIVER=postgres:
DATABASE_URL=
# Only consulted by `prisma migrate`/`prisma db`, never by the running app
# or `prisma generate`. Only required (non-empty) when you actually run a
# migrate command (defaults to the same value as DATABASE_URL; only
# differs for a pooled connection like Neon's "-pooler" host).
DIRECT_URL=

# Only needed once ENGINE_DRIVER=http:
ENGINE_BASE_URL=
ENGINE_API_KEY=

# simulated -> no external Sequence Template/Execution motor needed (default here).
# http -> requires SEQUENCE_MOTOR_BASE_URL and SEQUENCE_MOTOR_API_KEY below.
SEQUENCE_MOTOR_MODE=simulated
SEQUENCE_MOTOR_BASE_URL=
SEQUENCE_MOTOR_API_KEY=
SEQUENCE_MOTOR_TIMEOUT_MS=10000

# Fase Firma — signature images. simulated -> local /uploads/signatures/, no R2 needed.
SIGNATURE_ASSET_STORAGE_MODE=simulated
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=https://assets.mejoreferido.com
R2_SIGNATURE_PREFIX=signatures

# Optional — public base URL for /uploads/... image links; defaults to
# http://localhost:<PORT> when unset.
API_PUBLIC_URL=

# External, read-only Neon CRM database (maestro_clientes). mock -> demo
# dataset; postgres -> requires CRM_DATABASE_URL. Never log/commit the URL.
CRM_DRIVER=mock
CRM_DATABASE_URL=
CRM_ACTIVE_STATUS_VALUE=ACTIVO

AUTH_SECRET=replace_with_a_secure_value
CREDENTIALS_ENCRYPTION_KEY=replace_with_a_base64_32_byte_key

DEV_ADMIN_EMAIL=admin@local.test
DEV_ADMIN_PASSWORD=replace_with_a_secure_value
DEV_EXECUTIVE_EMAIL=ejecutivo@local.test
DEV_EXECUTIVE_PASSWORD=replace_with_a_secure_value
