// ---------------------------------------------------------------------------
// Etapa "cuenta del ejecutivo" — Plantilla/Gestión, deliberately new/additive
// tables rather than a reuse of Sequence/SequenceStep above: those keep
// backing the admin "Secuencias" monitor and the old wizard untouched.
// A SequenceTemplate is reusable content tied to exactly one Mailbox; a
// SequenceExecution is one concrete run against an immutable published
// SequenceTemplateVersion. Railway (the "motor") computes and performs the
// actual sends for a Gestión — no ScheduledEmail-equivalent is modeled here.
// ---------------------------------------------------------------------------

enum SequenceTemplateStatus {
  DRAFT
  PUBLISHING
  PUBLISHED
  PUBLISH_FAILED
  ARCHIVED
}

model SequenceTemplate {
  id                  String                 @id @default(uuid())
  organizationId      String
  ownerUserId         String
  mailboxId           String
  name                String
  description         String?
  /// §5 (revised) — shared across the 3 envíos. Header is no longer shared
  /// here (moved back to per-envío on SequenceTemplateStep.headerText) — this
  /// column is vestigial, kept only so no destructive migration is needed.
  subjectTemplate     String                 @default("")
  headerText          String?
  /// Fase Firma — the Plantilla's own editable signature draft (see SequenceTemplateVersion.signatureHtml for the frozen per-version snapshot).
  signatureHtml       String                 @default("")
  status              SequenceTemplateStatus @default(DRAFT)
  currentDraftVersion Int                    @default(1)
  timezone            String                 @default("America/Santiago")
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  archivedAt          DateTime?
  /// §11 — logical delete for an archived template; never a hard delete (preserves historical FK integrity for executions/versions).
  deletedAt           DateTime?

  organization Organization              @relation(fields: [organizationId], references: [id])
  owner        User                      @relation(fields: [ownerUserId], references: [id])
  mailbox      Mailbox                   @relation(fields: [mailboxId], references: [id])
  steps        SequenceTemplateStep[]
  versions     SequenceTemplateVersion[]
  executions   SequenceExecution[]

  @@index([organizationId])
  @@index([organizationId, ownerUserId])
  @@index([mailboxId])
  @@map("sequence_templates")
}

enum SequenceTemplateStepDelayUnit {
  MINUTES
  HOURS
  CALENDAR_DAYS
  BUSINESS_DAYS
}

enum SequenceTemplateStepDelayReference {
  EXECUTION_START
  PREVIOUS_STEP
}

model SequenceTemplateStep {
  id              String                             @id @default(uuid())
  organizationId  String
  templateId      String
  stepNumber      Int
  name            String
  enabled         Boolean                            @default(true)
  subjectTemplate String                             @default("")
  /// Vestigial — never read/written since the shared-header revision; superseded by headerText below.
  headerHtml      String?
  /// §4 (revised) — individual, optional header per envío, plain text (no HTML editor); see SequenceTemplatesService.
  headerText      String?
  bodyHtml        String                             @default("")
  bodyText        String                             @default("")
  delayValue      Int                                @default(0)
  delayUnit       SequenceTemplateStepDelayUnit      @default(BUSINESS_DAYS)
  delayReference  SequenceTemplateStepDelayReference @default(PREVIOUS_STEP)
  /// String array of Weekday values (MONDAY..SUNDAY).
  allowedWeekdays Json                               @default("[\"MONDAY\",\"TUESDAY\",\"WEDNESDAY\",\"THURSDAY\",\"FRIDAY\"]")
  sendWindowStart String                             @default("09:00")
  sendWindowEnd   String                             @default("17:00")
  createdAt       DateTime                           @default(now())
  updatedAt       DateTime                           @updatedAt

  template SequenceTemplate @relation(fields: [templateId], references: [id])

  @@unique([templateId, stepNumber])
  @@index([organizationId])
  @@index([templateId])
  @@map("sequence_template_steps")
}

enum SequenceTemplateVersionStatus {
  REQUESTED
  ACCEPTED
  FAILED
}

model SequenceTemplateVersion {
  id                      String                        @id @default(uuid())
  templateId              String
  versionNumber           Int
  name                    String
  mailboxId               String
  timezone                String
  /// §5 — shared across the 3 envíos, frozen at publish time.
  subjectTemplate         String
  /// Vestigial — header is per-envío again, frozen inside each `steps[]` snapshot instead.
  headerText              String?
  signatureHtml           String
  /// Array of { key, required }.
  variables               Json
  /// Array of frozen SequenceTemplateVersionStepSnapshot (bodyHtml + headerText + schedule per envío).
  steps                   Json
  status                  SequenceTemplateVersionStatus @default(REQUESTED)
  serverTemplateId        String?                       @unique
  templateTokenCiphertext String?
  acceptedAt              DateTime?
  lastPublishCommandId    String?
  lastError               String?
  /// §12-17 — populated only when this version resulted from "Editar plantilla publicada" (a new TEMPLATE_VERSION_PUBLISH carrying previousServerTemplateId), never on the first publish.
  previousVersionNumber   Int?
  createdBy               String
  createdAt               DateTime                      @default(now())

  template   SequenceTemplate    @relation(fields: [templateId], references: [id])
  executions SequenceExecution[]

  @@unique([templateId, versionNumber])
  @@index([templateId])
  @@map("sequence_template_versions")
}

/// §7 — no SCHEDULED: the executive never picks a start date/time, so there is nothing to "schedule" locally. SUBMISSION_UNKNOWN means the /start call itself timed out — distinct from SUBMITTING, never silently conflated with it nor reverted to DRAFT.
/// §11 — ACCEPTED is the outcome of a successful submission; the server may separately report its own internal QUEUED status later (surfaced via serverStatus), never a decision Mr Outreach made.
/// Fase "Control operativo de Gestiones" — the six *_REQUESTED/PAUSED/STOPPED values below are
/// admin-initiated control states, layered on top of the existing submission lifecycle above.
/// RUNNING is unchanged (still set once the motor reports EXECUTION_PROCESSING); PAUSED/STOPPED
/// are new terminal-ish operative states reachable only from RUNNING/PAUSED via their own
/// *_REQUESTED transitional state — see ControlSequenceExecutionUseCase for the full transition
/// table. COMPLETED/FAILED/REJECTED remain the only truly terminal values; a paused or stopped
/// Gestión never loses its RUNNING-era progress counters.
enum SequenceExecutionStatus {
  DRAFT
  VALIDATING
  SUBMITTING
  SUBMISSION_UNKNOWN
  ACCEPTED
  RUNNING
  PAUSE_REQUESTED
  PAUSED
  RESUME_REQUESTED
  STOP_REQUESTED
  STOPPED
  RESTART_REQUESTED
  COMPLETED
  FAILED
  REJECTED
}

enum SequenceExecutionServerStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  REJECTED
}

model SequenceExecution {
  id                           String                         @id @default(uuid())
  organizationId               String
  executiveId                  String
  mailboxId                    String
  templateId                   String
  templateVersionId            String
  /// §3 — null while DRAFT; generated as "Gestión_DDMMYYYY[_n]" only when the start command is actually sent.
  name                         String?
  timezone                     String
  status                       SequenceExecutionStatus        @default(DRAFT)
  prospectImportId             String?                        @unique
  /// §5 — real submission-lifecycle instants; never a manually-picked date, never sent to the server.
  requestedAt                  DateTime?
  receivedAt                   DateTime?
  estimatedStartAt             DateTime?
  startedAt                    DateTime?
  completedAt                  DateTime?
  failedAt                     DateTime?
  serverStatus                 SequenceExecutionServerStatus?
  currentStepNumber            Int?
  sentCount                    Int?
  pendingCount                 Int?
  failedCount                  Int?
  receivedProspects            Int?
  acceptedProspects            Int?
  rejectedProspects            Int?
  /// §2 — the server's own initial per-prospect state on acceptance (contractually STEP_01_PENDING).
  initialProspectState         ProspectExecutionState?
  lastSyncedAt                 DateTime?
  lastError                    String?
  serverExecutionId            String?                        @unique
  executionTokenCiphertext     String?
  /// §11 — the idempotencyKey used for the most recent /start attempt; reused verbatim on retry.
  lastSubmissionIdempotencyKey String?
  createdBy                    String
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt

  // Fase "Control operativo de Gestiones" — admin pause/resume/stop instants and the
  // idempotency key reused across a control command's REQUESTED->ACCEPTED->terminal
  // lifecycle (same "reuse verbatim on retry" convention as lastSubmissionIdempotencyKey
  // above), plus the reason an admin gave for stopping. Never cleared once set — a
  // stopped-then-restarted execution keeps its own pausedAt/stoppedAt history; the NEW
  // attempt row is a separate execution (see previousExecutionId below).
  pausedAt                   DateTime?
  resumedAt                  DateTime?
  stoppedAt                  DateTime?
  stopReason                 String?
  lastControlIdempotencyKey  String?

  // Fase "Reiniciar Gestión" — restarting a STOPPED execution never rewrites it: it creates
  // a brand-new SequenceExecution row (this one, self-linked to the STOPPED one it restarts)
  // scoped to only the contacts that never received any email in the previous attempt.
  // previousExecutionId is unique because each stopped execution can be restarted into at
  // most one new attempt at a time (a second restart attempt targets the newest one, not
  // the original). executionAttempt starts at 1 and increments by 1 per restart.
  executionAttempt   Int                 @default(1)
  previousExecutionId String?            @unique
  previousExecution   SequenceExecution? @relation("SequenceExecutionRestart", fields: [previousExecutionId], references: [id])
  restartedAsExecution SequenceExecution? @relation("SequenceExecutionRestart")

  organization    Organization            @relation(fields: [organizationId], references: [id])
  executive       User                    @relation(fields: [executiveId], references: [id])
  mailbox         Mailbox                 @relation(fields: [mailboxId], references: [id])
  template        SequenceTemplate        @relation(fields: [templateId], references: [id])
  templateVersion SequenceTemplateVersion @relation(fields: [templateVersionId], references: [id])
  prospectImport  ProspectImport?
  conversations   Conversation[]

  @@index([organizationId])
  @@index([organizationId, executiveId])
  @@index([templateId])
  @@index([mailboxId])
  @@map("sequence_executions")
}

enum ProspectImportStatus {
  UPLOADED
  MAPPING_REQUIRED
  VALIDATING
  READY
  FAILED
}

model ProspectImport {
  id             String               @id @default(uuid())
  organizationId String
  executionId    String               @unique
  fileName       String
  storageKey     String
  checksum       String
  status         ProspectImportStatus @default(UPLOADED)
  /// ProspectColumnMapping | null.
  columnMapping  Json?
  totalRows      Int                  @default(0)
  validRows      Int                  @default(0)
  invalidRows    Int                  @default(0)
  duplicateRows  Int                  @default(0)
  excludedRows   Int                  @default(0)
  createdBy      String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  execution SequenceExecution   @relation(fields: [executionId], references: [id])
  rows      ProspectImportRow[]

  @@index([organizationId])
  @@map("prospect_imports")
}

enum ProspectImportRowValidationStatus {
  VALID
  INVALID
  DUPLICATE
}

/// §2/§11 — server-administered per-prospect lifecycle; Mr Outreach only records what the server itself reported.
enum ProspectExecutionState {
  STEP_01_PENDING
  STEP_01_PROCESSING
  STEP_01_SENT
  STEP_02_PENDING
  STEP_02_PROCESSING
  STEP_02_SENT
  STEP_03_PENDING
  STEP_03_PROCESSING
  STEP_03_SENT
  COMPLETED
  FAILED
}

model ProspectImportRow {
  id               String                            @id @default(uuid())
  organizationId   String
  importId         String
  rowNumber        Int
  rawData          Json
  /// NormalizedProspectData | null.
  normalizedData   Json?
  validationStatus ProspectImportRowValidationStatus
  validationErrors Json                              @default("[]")
  /// Null until the Gestión this row belongs to is accepted by the server.
  executionState   ProspectExecutionState?
  /// Fase "Conversaciones persistentes" — resolved/created by ProspectIdentityResolver
  /// once the row is accepted, reusing the same companies/contacts tables the
  /// legacy import flow already writes to (never a parallel identity table).
  /// Null until resolution runs; never overwritten with an empty value once set.
  companyId        String?
  contactId        String?
  resolvedAt       DateTime?
  createdAt        DateTime                          @default(now())

  import        ProspectImport @relation(fields: [importId], references: [id])
  company       Company?       @relation(fields: [companyId], references: [id])
  contact       Contact?       @relation(fields: [contactId], references: [id])
  conversations Conversation[]

  @@unique([importId, rowNumber])
  @@index([organizationId])
  @@index([importId])
  @@index([importId, validationStatus])
  @@index([companyId])
  @@index([contactId])
  @@map("prospect_import_rows")
}

// ---------------------------------------------------------------------------
// Conversaciones — previously in-memory only (unconditionally, even with
// PERSISTENCE_DRIVER=postgres; see persistence.module.ts's prior
// CONVERSATION_REPOSITORY-family wiring). Field names mirror the existing
// domain entities in domain/conversation/* as closely as possible so
// ConversationsService/ReplySimulationService/ResponseOutcomeService need no
// unrelated renames — only additive fields for the active-flow attribution
// (sequenceExecutionId, prospectImportRowId, origin) and for per-user read
// state (ConversationReadState, new) were introduced.
//
// isUnread on Conversation is kept as-is (a coarse, non-authoritative signal)
// — ConversationReadState is the source of truth for "has user X read this",
// so a read by one user never marks it read for anyone else.
// ---------------------------------------------------------------------------

enum ConversationManagementStatus {
  NEW
  PENDING
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

enum ConversationClassification {
  INTERESTED
  NOT_INTERESTED
  REQUESTS_INFORMATION
  FOLLOW_UP_LATER
  WRONG_CONTACT
  OUT_OF_OFFICE
  AUTOMATIC_REPLY
  HARD_BOUNCE
  SOFT_BOUNCE
  UNSUBSCRIBE
  UNCLASSIFIED
}

/// The executive's deliberate business decision about a reply — distinct
/// from ConversationClassification (auto-detected). Mirrors
/// domain/conversation/conversation.entity.ts's ResponseOutcome exactly.
enum ConversationResponseOutcome {
  NOT_INTERESTED
  DO_NOT_CONTACT
  INTERESTED
  REFERRED
}

/// Which system produced this Conversation — makes the source explicit
/// instead of leaving it to be inferred from which legacy/active foreign
/// keys happen to be non-null.
enum ConversationOrigin {
  /// Created by the active Plantillas/Gestiones flow (sequenceExecutionId/prospectImportRowId populated).
  ACTIVE_EXECUTION
  /// Created by ReplySimulationService against the legacy Sequence/SequenceContact/ScheduledEmail aggregate.
  LEGACY_SEQUENCE
  /// Created by ConversationsService.syncMailbox from a raw IMAP thread with no matching Contact/SequenceContact/SequenceExecution at all.
  EXTERNAL_INBOUND
}

model Conversation {
  id             String  @id @default(uuid())
  organizationId String
  clientId       String?
  domainId       String?
  mailboxId      String

  /// The engine's thread id for EXTERNAL_INBOUND; a synthetic `sim-thread-*` id for LEGACY_SEQUENCE/ACTIVE_EXECUTION — both are how sync/simulation find the row again idempotently.
  emailThreadId       String
  contactEmail        String
  contactName         String?
  /// Denormalized fallback for when no companyId is resolved yet (e.g. before ProspectIdentityResolver runs, or for EXTERNAL_INBOUND conversations with no import row at all).
  companyNameSnapshot String?
  contactId           String?
  companyId           String?

  /// Which flow created this row — never inferred from which FKs are non-null.
  origin ConversationOrigin

  // --- Legacy attribution (Secuencias) — nullable, kept only for historical
  // conversations; new ACTIVE_EXECUTION rows must never populate these.
  sequenceContactId           String?
  originatingScheduledEmailId String?
  sequenceId                  String?
  sequenceStepId              String?

  // --- Active-flow attribution (Plantillas/Gestiones) — nullable; new
  // conversations should populate these instead of the legacy fields above.
  sequenceExecutionId String?
  prospectImportRowId String?

  assignedExecutiveId String?
  subject             String
  managementStatus    ConversationManagementStatus @default(NEW)
  classification      ConversationClassification   @default(UNCLASSIFIED)
  responseOutcome     ConversationResponseOutcome?
  /// Coarse signal only — see file header comment. Not per-user.
  isUnread            Boolean                      @default(true)
  lastMessageAt       DateTime
  resolvedAt          DateTime?
  resolvedBy          String?
  archivedAt          DateTime?

  /// "Conversaciones de prueba" (QA) — true only for rows created by GenerateSimulationConversationsUseCase; never true for a real conversation.
  isSimulation       Boolean                      @default(false)
  simulationBatchId  String?
  /// The SUGGESTED scenario shown as a hint in the UI — never auto-applied to responseOutcome, which only a manual classification ever sets.
  simulationScenario ConversationResponseOutcome?

  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  deletedAt           DateTime?

  organization      Organization                  @relation(fields: [organizationId], references: [id])
  client            ManagedClient?                @relation(fields: [clientId], references: [id])
  domain            Domain?                       @relation(fields: [domainId], references: [id])
  mailbox           Mailbox                       @relation(fields: [mailboxId], references: [id])
  contact           Contact?                      @relation(fields: [contactId], references: [id])
  company           Company?                      @relation(fields: [companyId], references: [id])
  sequenceContact   SequenceContact?              @relation(fields: [sequenceContactId], references: [id])
  originatingEmail  ScheduledEmail?               @relation(fields: [originatingScheduledEmailId], references: [id])
  sequence          Sequence?                     @relation(fields: [sequenceId], references: [id])
  sequenceStep      SequenceStep?                 @relation(fields: [sequenceStepId], references: [id])
  sequenceExecution SequenceExecution?            @relation(fields: [sequenceExecutionId], references: [id])
  prospectImportRow ProspectImportRow?            @relation(fields: [prospectImportRowId], references: [id])
  assignedExecutive User?                         @relation("ConversationAssignedExecutive", fields: [assignedExecutiveId], references: [id])
  simulationBatch   SimulationConversationBatch?  @relation(fields: [simulationBatchId], references: [id], onDelete: SetNull)
  messages          ConversationMessage[]
  notes             ConversationNote[]
  tagAssignments    ConversationTagAssignment[]
  readStates        ConversationReadState[]

  @@unique([mailboxId, emailThreadId])
  @@index([organizationId])
  @@index([clientId])
  @@index([mailboxId])
  @@index([assignedExecutiveId])
  @@index([organizationId, classification])
  @@index([organizationId, managementStatus])
  @@index([sequenceExecutionId])
  @@index([prospectImportRowId])
  @@index([sequenceContactId])
  @@index([simulationBatchId])
  @@map("conversations")
}

/// "Conversaciones de prueba" (QA) — one generation of the 4 fixed scenario
/// conversations (Interesado/No interesado/No contactar/Deriva) against one
/// real, staging-only Mailbox. Holds no relations to the synthetic
/// Contact/Company/Sequence/SequenceContact it caused to be created — those
/// are found by querying Conversation.simulationBatchId at deletion time
/// (see DeleteSimulationConversationsUseCase), since every synthetic row is
/// reachable from its Conversation's own foreign keys.
model SimulationConversationBatch {
  id              String   @id @default(uuid())
  organizationId  String
  mailboxId       String
  createdByUserId String
  idempotencyKey  String
  createdAt       DateTime @default(now())
  metadata        Json?

  conversations Conversation[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@map("simulation_conversation_batches")
}

enum ConversationDirection {
  INBOUND
  OUTBOUND
}

enum ConversationMessageType {
  HUMAN_REPLY
  OUTREACH_EMAIL
  AUTO_REPLY
  OUT_OF_OFFICE
  HARD_BOUNCE
  SOFT_BOUNCE
  UNSUBSCRIBE
  UNKNOWN
}

model ConversationMessage {
  id             String @id @default(uuid())
  organizationId String
  conversationId String
  mailboxId      String

  /// The engine's message id (existing dedup key — see findByEmailMessageId, scoped by conversationId, not renamed).
  emailMessageId    String
  direction         ConversationDirection
  /// Fase "active flow" additions — the motor's own message identifier and, for an OUTBOUND send, the id that anchors a later reply's In-Reply-To/References back to this exact message. Neither has contractual evidence of global uniqueness yet — scoped by organizationId, not global (see docs/database-architecture.md's identifier matrix).
  serverMessageId   String?
  outboundMessageId String?
  /// RFC 2822 headers, copied verbatim — never parsed into a relational structure (references is a single text blob, not its own table; see Fase 2 design note on why no MessageExternalIdentifier table exists).
  messageIdHeader   String?
  inReplyTo         String?
  references        String?

  senderEmail String
  senderName  String?
  /// Denormalized email address lists — never queried relationally (no "all conversations where X was cc'd"), so JSON is sufficient.
  recipients  Json    @default("[]")
  cc          Json    @default("[]")
  bcc         Json    @default("[]")

  subject       String
  htmlBody      String
  plainTextBody String
  /// Which envío (1/2/3) of the active-flow template this message corresponds to, when known.
  stepNumber    Int?
  receivedAt    DateTime?
  sentAt        DateTime?
  messageType   ConversationMessageType
  createdAt     DateTime                @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])
  mailbox      Mailbox      @relation(fields: [mailboxId], references: [id])

  @@unique([conversationId, emailMessageId])
  // Provisional: no motor contract confirms global uniqueness for any of
  // these — composite with organizationId until one does. Postgres treats
  // every NULL as distinct, so nullable rows never collide with each other.
  @@unique([organizationId, messageIdHeader])
  @@unique([organizationId, serverMessageId])
  @@unique([organizationId, outboundMessageId])
  @@index([organizationId])
  @@index([conversationId])
  @@map("conversation_messages")
}

model ConversationTag {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  color          String
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization                @relation(fields: [organizationId], references: [id])
  assignments  ConversationTagAssignment[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("conversation_tags")
}

/// Bridge table — administered entirely through ConversationRepository's
/// existing addTag/removeTag/listTagIds methods (see conversation.repository.ts);
/// deliberately not its own repository, per "no crear siete repositorios
/// artificiales" — this is a join, not an independent aggregate.
model ConversationTagAssignment {
  conversationId   String
  tagId            String
  organizationId   String
  assignedByUserId String
  createdAt        DateTime @default(now())

  conversation Conversation    @relation(fields: [conversationId], references: [id])
  tag          ConversationTag @relation(fields: [tagId], references: [id])

  @@id([conversationId, tagId])
  @@index([organizationId])
  @@index([tagId])
  @@map("conversation_tag_assignments")
}

model ConversationNote {
  id              String                       @id @default(uuid())
  organizationId  String
  conversationId  String
  authorUserId    String
  content         String
  /// Set when auto-created from the "Resultado de la respuesta" modal — null for manually-added notes. Never sent to the contact or to the motor.
  responseOutcome ConversationResponseOutcome?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  deletedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])
  author       User         @relation(fields: [authorUserId], references: [id])

  @@index([organizationId])
  @@index([conversationId])
  @@map("conversation_notes")
}

/// Per-user read state — the source of truth for "has user X read this
/// conversation" (Conversation.isUnread is a coarser, non-authoritative
/// signal only). A read by one user never marks it read for anyone else.
model ConversationReadState {
  organizationId    String
  conversationId    String
  userId            String
  lastReadMessageId String?
  lastReadAt        DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@id([conversationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("conversation_read_states")
}
