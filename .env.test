# Committed on purpose — unlike the other .env.<environment> files, this
# one holds no real secrets: it only exists so the e2e/unit test suite
# runs deterministically in any environment (a dev machine or CI)
# without requiring a developer's local ".env" to be present first.
# Always memory + mock: tests must never need PostgreSQL, Hetzner, or a
# real engine.
NODE_ENV=test

PERSISTENCE_DRIVER=memory
ENGINE_DRIVER=mock

AUTH_SECRET=test-only-secret-do-not-use-outside-tests-0123456789
# 32 zero bytes, base64-encoded — fine for tests, never reuse elsewhere.
CREDENTIALS_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Fase "Recepción de eventos del motor" — a fixed, publicly-known test
# value (never a real secret) so e2e specs can sign synthetic requests to
# POST /integration/events deterministically.
MOTOR_EVENT_AUTH_MODE=hmac
MOTOR_EVENT_HMAC_SECRET=test-only-hmac-secret-do-not-use-outside-tests
MOTOR_EVENT_MAX_CLOCK_SKEW_SECONDS=300

DEV_ADMIN_EMAIL=admin@local.test
DEV_ADMIN_PASSWORD=test-admin-password

DEV_EXECUTIVE_EMAIL=ejecutivo@local.test
DEV_EXECUTIVE_PASSWORD=test-executive-password
