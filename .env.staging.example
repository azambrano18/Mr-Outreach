# Template for the Staging environment. The real ".env.staging" is never
# committed — it is provisioned directly on the staging host/CI.
# Staging runs in integrated mode against its own PostgreSQL (Hetzner) and
# its own engine instance — never against Production's.
#
# On Railway, `npm run start:prod` sets NODE_ENV=production unconditionally
# — that is correct and must NOT be "fixed" to "staging"; it's only
# Node/Nest's execution mode. APP_ENV below is what actually identifies
# this as Staging — see docs/environment-variables.md for the full
# explanation and the incident this distinction fixes.
NODE_ENV=production
APP_ENV=staging

PERSISTENCE_DRIVER=postgres
ENGINE_DRIVER=http
# "remote" is NOT implemented yet (RemoteMailEngineAdapter is a stub) — keep
# this at "simulation" until the real engine integration lands, even here.
MAIL_ENGINE_MODE=simulation
STORAGE_DRIVER=local

DATABASE_URL="postgresql://app_user:PASSWORD@10.0.1.5:5432/outreach_staging?sslmode=require"
# Only consulted by `prisma migrate`/`prisma db`, never by the running app.
# Must be non-empty whenever DATABASE_URL is set — same value here since
# this host isn't pooled; use the provider's direct endpoint if it ever is.
DIRECT_URL="postgresql://app_user:PASSWORD@10.0.1.5:5432/outreach_staging?sslmode=require"
ENGINE_BASE_URL="https://engine-staging.internal"
ENGINE_API_KEY=replace_with_a_secure_value

# simulated -> the mailbox-linking motor is an in-process fixture, useful
# for testing the LINKED -> UNLINKING -> UNLINKED -> DELETED flow
# deterministically without a real Railway motor. http -> requires
# MAILBOX_MOTOR_BASE_URL/MAILBOX_MOTOR_API_KEY below. Both are valid in
# Staging (APP_ENV=staging above) — only APP_ENV=production forces "http".
MAILBOX_MOTOR_DRIVER=simulated
MAILBOX_MOTOR_BASE_URL=
MAILBOX_MOTOR_API_KEY=

# http -> Staging talks to its own Sequence Template/Execution motor instance,
# never Production's. Required once real Railway staging is reachable.
SEQUENCE_MOTOR_MODE=http
SEQUENCE_MOTOR_BASE_URL="https://sequence-motor-staging.internal"
SEQUENCE_MOTOR_API_KEY=replace_with_a_secure_value
SEQUENCE_MOTOR_TIMEOUT_MS=10000

# Fase "Recepción de eventos del motor" — a dedicated Staging secret,
# never Production's.
MOTOR_EVENT_AUTH_MODE=hmac
MOTOR_EVENT_HMAC_SECRET=replace_with_a_secure_value
MOTOR_EVENT_MAX_CLOCK_SKEW_SECONDS=300

# Fase Firma — a dedicated staging bucket/prefix, never Production's.
SIGNATURE_ASSET_STORAGE_MODE=r2
R2_ACCOUNT_ID=replace_with_cloudflare_account_id
R2_ACCESS_KEY_ID=replace_with_a_secure_value
R2_SECRET_ACCESS_KEY=replace_with_a_secure_value
R2_BUCKET_NAME=mr-outreach-staging-assets
R2_PUBLIC_BASE_URL="https://assets-staging.mejoreferido.com"
R2_SIGNATURE_PREFIX=firmas
R2_EMAIL_BODY_PREFIX=email-body

# Public base URL this API is reachable at — used to build /uploads/... links.
API_PUBLIC_URL="https://api-staging.outreach.example.com"

AUTH_SECRET=replace_with_a_secure_value
CREDENTIALS_ENCRYPTION_KEY=replace_with_a_base64_32_byte_key

# DEV_* vars are not used outside PERSISTENCE_DRIVER=memory; omit them here.
