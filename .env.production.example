# Template for the Production environment. The real ".env.production" is
# never committed and, ideally, never even hand-copied: production
# DATABASE_URL/ENGINE_API_KEY should be injected by the deployment
# platform/secrets manager. This file only documents which variables
# Production expects.
NODE_ENV=production
# The real deployment environment — distinct from NODE_ENV (see
# docs/environment-variables.md). Production-only restrictions (e.g.
# MAILBOX_MOTOR_DRIVER must be "http") gate on this, never on NODE_ENV,
# because Staging also runs with NODE_ENV=production on Railway.
APP_ENV=production

PERSISTENCE_DRIVER=postgres
ENGINE_DRIVER=http
# "remote" is NOT implemented yet (RemoteMailEngineAdapter is a stub) — keep
# this at "simulation" until the real engine integration lands, even here.
MAIL_ENGINE_MODE=simulation
STORAGE_DRIVER=local

DATABASE_URL="postgresql://app_user:PASSWORD@10.0.2.5:5432/outreach_production?sslmode=require"
# Only consulted by `prisma migrate`/`prisma db`, never by the running app.
# Must be non-empty whenever DATABASE_URL is set — same value here since
# this host isn't pooled; use the provider's direct endpoint if it ever is.
DIRECT_URL="postgresql://app_user:PASSWORD@10.0.2.5:5432/outreach_production?sslmode=require"
ENGINE_BASE_URL="https://engine.internal"
ENGINE_API_KEY=replace_with_a_secure_value

# Production must always use the real motor — the API refuses to boot
# with MAILBOX_MOTOR_DRIVER=simulated whenever APP_ENV=production.
MAILBOX_MOTOR_DRIVER=http
MAILBOX_MOTOR_BASE_URL="https://mailbox-motor.internal"
MAILBOX_MOTOR_API_KEY=replace_with_a_secure_value

# http -> the real Railway Sequence Template/Execution motor. Never point
# Production at the Staging or a test/demo motor instance.
SEQUENCE_MOTOR_MODE=http
SEQUENCE_MOTOR_BASE_URL="https://sequence-motor.internal"
SEQUENCE_MOTOR_API_KEY=replace_with_a_secure_value
SEQUENCE_MOTOR_TIMEOUT_MS=10000

# Fase "Recepción de eventos del motor" — real, unique-per-environment
# secret. Never reuse the Staging value here. Empty disables the
# POST /integration/events endpoint (404) rather than accepting unsigned
# events — there is no "accept everything" fallback mode.
MOTOR_EVENT_AUTH_MODE=hmac
MOTOR_EVENT_HMAC_SECRET=replace_with_a_secure_value
MOTOR_EVENT_MAX_CLOCK_SKEW_SECONDS=300

# Fase Firma — real Cloudflare R2 bucket. Never r2.dev — a custom domain
# (see docs/signature-assets-r2-setup.md for the external setup steps).
SIGNATURE_ASSET_STORAGE_MODE=r2
R2_ACCOUNT_ID=replace_with_cloudflare_account_id
R2_ACCESS_KEY_ID=replace_with_a_secure_value
R2_SECRET_ACCESS_KEY=replace_with_a_secure_value
R2_BUCKET_NAME=mr-outreach-production-assets
R2_PUBLIC_BASE_URL="https://assets.mejoreferido.com"
R2_SIGNATURE_PREFIX=firmas
R2_EMAIL_BODY_PREFIX=email-body

# Public base URL this API is reachable at — used to build /uploads/... links.
API_PUBLIC_URL="https://api.outreach.example.com"

AUTH_SECRET=replace_with_a_secure_value
CREDENTIALS_ENCRYPTION_KEY=replace_with_a_base64_32_byte_key

# DEV_* vars are not used outside PERSISTENCE_DRIVER=memory; omit them here.
