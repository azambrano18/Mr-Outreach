# Template for the Production environment. The real ".env.production" is
# never committed and, ideally, never even hand-copied: production
# DATABASE_URL/ENGINE_API_KEY should be injected by the deployment
# platform/secrets manager. This file only documents which variables
# Production expects.
NODE_ENV=production

PERSISTENCE_DRIVER=postgres
ENGINE_DRIVER=http
# "remote" is NOT implemented yet (RemoteMailEngineAdapter is a stub) — keep
# this at "simulation" until the real engine integration lands, even here.
MAIL_ENGINE_MODE=simulation
STORAGE_DRIVER=local

DATABASE_URL="postgresql://app_user:PASSWORD@10.0.2.5:5432/outreach_production?sslmode=require"
# Only consulted by `prisma migrate`/`prisma db`, never by the running app.
# Must be non-empty whenever DATABASE_URL is set — same value here since
# this host isn't pooled; use the provider's direct endpoint if it ever is.
DIRECT_URL="postgresql://app_user:PASSWORD@10.0.2.5:5432/outreach_production?sslmode=require"
ENGINE_BASE_URL="https://engine.internal"
ENGINE_API_KEY=replace_with_a_secure_value

# Public base URL this API is reachable at — used to build /uploads/... links.
API_PUBLIC_URL="https://api.outreach.example.com"

# External, read-only Neon CRM database (maestro_clientes) — a Neon user
# with read-only access to that one table, never the DB owner credentials.
CRM_DRIVER=postgres
CRM_DATABASE_URL="postgresql://crm_readonly_user:PASSWORD@ep-example.neon.tech/CRM?sslmode=require"
CRM_ACTIVE_STATUS_VALUE=ACTIVO

AUTH_SECRET=replace_with_a_secure_value
CREDENTIALS_ENCRYPTION_KEY=replace_with_a_base64_32_byte_key

# DEV_* vars are not used outside PERSISTENCE_DRIVER=memory; omit them here.
