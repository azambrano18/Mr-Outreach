{
  "name": "outreach-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run start:dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w packages/shared-types && npm run build -w packages/validation && npm run build -w packages/ui && npm run build -w apps/api && npm run build -w apps/web",
    "lint": "eslint . && npm run lint -w apps/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test -w packages/validation && npm run test -w apps/api",
    "test:e2e": "npm run test:e2e -w apps/api",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts",
    "prisma:bootstrap-admin": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/bootstrap-admin.ts",
    "test:bootstrap-admin": "jest --config jest.config.prisma.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@prisma/client": "^5.20.0",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "bcryptjs": "^2.4.3",
    "concurrently": "^9.0.0",
    "typescript-eslint": "^8.5.0",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "prisma": "^5.20.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
