# Used by client-side code (the home page's health check fetch).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Used only by server-side code (Route Handlers, Server Components) that
# proxy to the API — e.g. the auth BFF routes. Not exposed to the browser.
# Defaults to NEXT_PUBLIC_API_URL if unset; only set this separately if
# the server-to-server address differs from the browser-facing one.
API_INTERNAL_URL=http://localhost:3001
