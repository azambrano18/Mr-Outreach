# App-specific settings only. Everything else (PERSISTENCE_DRIVER,
# ENGINE_DRIVER, DATABASE_URL, ENGINE_BASE_URL, AUTH_SECRET, DEV_* seed
# credentials) is read from the repo root ".env" (or ".env.<NODE_ENV>") —
# see ../../.env.example. Copy this file only if you need to override
# PORT/WEB_ORIGIN locally; it is optional otherwise.
PORT=3001

# CORS: main.ts's app.enableCors() only allows requests from this exact
# origin (credentials: true). Must match the Next.js app's real origin —
# a mismatch here breaks the BFF login cookie flow, never widen this to "*".
WEB_ORIGIN=http://localhost:3000

# Also indirectly controls cookies: the Next.js BFF's session cookie is
# always httpOnly + sameSite=lax, and its "secure" flag follows NODE_ENV
# (secure only when NODE_ENV=production) — see apps/web/app/api/auth/login/route.ts.
NODE_ENV=development

# ---------------------------------------------------------------------
# CRM (Neon) — external, read-only, master source of clients (table
# maestro_clientes). Never a real value here or in any versioned file —
# see README > "CRM durante desarrollo y pruebas".
# ---------------------------------------------------------------------
# mock     -> no external database needed; deterministic demo clients.
# postgres -> requires CRM_DATABASE_URL below, a dedicated read-only role
#             (never neondb_owner). Copy this file to ".env" (gitignored)
#             to enable real local development against the real catalog.
CRM_DRIVER=mock
CRM_DATABASE_URL=
CRM_ACTIVE_STATUS_VALUE=ACTIVO

# Tests always force CRM_DRIVER=mock via ".env.test" (see that file and
# the README section above) regardless of what this file sets — never
# rely on ordinary test runs to catch a real-CRM misconfiguration here.
