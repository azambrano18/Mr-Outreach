# Template only — never put real credentials in this file (it is versioned).
# Copy to ".env" for local development. "./.env" is gitignored and must
# never be committed.
NODE_ENV=development

# ---------------------------------------------------------------------
# Driver selection — see README > "Modalidad simulada vs integrada".
# ---------------------------------------------------------------------
# memory  -> no PostgreSQL needed at all; data lives in process memory.
# postgres -> requires DATABASE_URL below (Hetzner-hosted, remote).
PERSISTENCE_DRIVER=memory

# mock -> no external engine needed; simulated, deterministic results.
# http -> requires ENGINE_BASE_URL below.
ENGINE_DRIVER=mock

# simulation -> the async command/event integration layer (mailbox
# provisioning, sequence publish, imports, scheduled sends) runs against
# SimulatedMailEngineAdapter, no external engine required.
# remote -> would use RemoteMailEngineAdapter — not implemented yet, see
# README > "Fase 12"; do not set this to "remote" in this codebase.
MAIL_ENGINE_MODE=simulation

# local -> signature/upload images are written to disk under apps/api/uploads
# (served back at /uploads/...). s3 -> not configured in this codebase yet.
STORAGE_DRIVER=local

# ---------------------------------------------------------------------
# Only required when PERSISTENCE_DRIVER=postgres.
# ---------------------------------------------------------------------
# Remote PostgreSQL hosted on Hetzner, reachable only over a private
# network / VPN / tunnel. TLS and other connection tuning are expressed
# as query parameters on this URL (Prisma convention), e.g.
# "...?sslmode=require".
DATABASE_URL=

# Only consulted by `prisma migrate`/`prisma db` commands (schema.prisma's
# datasource.directUrl) — the running app and `prisma generate` never need
# this. Only required (non-empty) when you actually run a migrate command
# against PERSISTENCE_DRIVER=postgres. Defaults to the same value as
# DATABASE_URL — only needs to differ when DATABASE_URL is a pooled
# connection (e.g. Neon's "-pooler" endpoint), in which case this must be
# that same provider's direct/non-pooled endpoint.
DIRECT_URL=

# ---------------------------------------------------------------------
# Only required when ENGINE_DRIVER=http.
# ---------------------------------------------------------------------
ENGINE_BASE_URL=
ENGINE_API_KEY=

# ---------------------------------------------------------------------
# Gates SequenceTemplateMotorPort/SequenceExecutionMotorPort — the
# Railway-hosted engine that accepts a published Plantilla (versioned) and
# starts a Gestión. A third external system, distinct from both
# MAILBOX_MOTOR_* (account linking) and ENGINE_DRIVER/MAIL_ENGINE_MODE
# (the legacy simulated sequence engine). See docs/railway-integration-contract-v1.md.
# ---------------------------------------------------------------------
# simulated -> SimulatedSequenceTemplateMotorAdapter/SimulatedSequenceExecutionMotorAdapter,
#              no external connection needed (the mode used today).
# http      -> requires SEQUENCE_MOTOR_BASE_URL and SEQUENCE_MOTOR_API_KEY below;
#              the API refuses to start if either is missing.
SEQUENCE_MOTOR_MODE=simulated
SEQUENCE_MOTOR_BASE_URL=
SEQUENCE_MOTOR_API_KEY=
SEQUENCE_MOTOR_TIMEOUT_MS=10000

# ---------------------------------------------------------------------
# Fase "Recepción de eventos del motor" — authenticates inbound
# POST /integration/events calls (the motor telling Mr Outreach about a
# Gestión's progress, an outbound send, or a reply). Never required at
# boot — leaving MOTOR_EVENT_HMAC_SECRET empty simply disables the
# endpoint (it 404s) in every environment, including production; there is
# no mode that accepts an unsigned event.
# ---------------------------------------------------------------------
# hmac -> the only mode implemented today. Signature =
#         hex(HMAC-SHA256(secret, "<timestamp>.<rawBody>")), sent as the
#         X-Motor-Signature/X-Motor-Timestamp headers.
MOTOR_EVENT_AUTH_MODE=hmac
MOTOR_EVENT_HMAC_SECRET=
MOTOR_EVENT_MAX_CLOCK_SKEW_SECONDS=300

# ---------------------------------------------------------------------
# Fase Firma — SignatureAssetStoragePort (images embedded in a Plantilla's
# signature). Independent of STORAGE_DRIVER (the older, generic rich-text
# image port).
# ---------------------------------------------------------------------
# simulated -> SimulatedSignatureAssetStorageAdapter, writes under
#              apps/api/uploads/signatures/ and serves it via the same
#              /uploads/* static mount main.ts already exposes.
# r2        -> R2SignatureAssetStorageAdapter (Cloudflare R2); requires every
#              R2_* variable below, and the API refuses to start otherwise.
SIGNATURE_ASSET_STORAGE_MODE=simulated
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Always required (even in `simulated` mode's own validation defaults) —
# the sanitizer uses this to decide which host a signature's <img src> may
# point at. Never r2.dev in production — use a custom domain.
R2_PUBLIC_BASE_URL=https://assets.mejoreferido.com
R2_SIGNATURE_PREFIX=signatures

# ---------------------------------------------------------------------
# Optional. Base URL this API process is publicly reachable at — only used
# to build public /uploads/... image URLs. Defaults to
# "http://localhost:<PORT>" when unset; only set this explicitly behind a
# reverse proxy or a different public hostname.
# ---------------------------------------------------------------------
API_PUBLIC_URL=

# ---------------------------------------------------------------------
# Always required. Signs session JWTs — generate a long random value,
# e.g. `openssl rand -base64 48`. Never reuse across environments.
# ---------------------------------------------------------------------
AUTH_SECRET=replace_with_a_secure_value

# ---------------------------------------------------------------------
# Always required. Encrypts IMAP/SMTP mailbox passwords (reversible —
# the engine needs the real secret back). Must decode to exactly 32
# bytes: generate with `openssl rand -base64 32`. Never reuse across
# environments; rotating it makes every previously stored mailbox
# password undecryptable.
# ---------------------------------------------------------------------
CREDENTIALS_ENCRYPTION_KEY=replace_with_a_base64_32_byte_key

# ---------------------------------------------------------------------
# Only required when PERSISTENCE_DRIVER=memory (used by the automatic
# in-memory dev seed — see README > "Seed de desarrollo").
# ---------------------------------------------------------------------
DEV_ADMIN_EMAIL=admin@local.test
DEV_ADMIN_PASSWORD=replace_with_a_secure_value

DEV_EXECUTIVE_EMAIL=ejecutivo@local.test
DEV_EXECUTIVE_PASSWORD=replace_with_a_secure_value
